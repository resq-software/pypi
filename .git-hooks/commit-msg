# Canonical ResQ commit-msg shim — source: resq-software/dev.
# Enforces Conventional Commits; blocks fixup/squash/WIP on main/master.

set -euo pipefail

HSKIP_HOOK='commit-msg'
HSKIP_HARD_FAIL=1  # gating hook: refuse to run rather than guess at intent

# ── GIT_HOOKS_SKIP — granular, fail-closed skip control ─────────────────────
# Historically ANY non-empty value disabled the entire hook, so a plausible
# looking `GIT_HOOKS_SKIP=audit` silently turned off the secret scan as well.
# It no longer does: values are parsed, unknown values are refused, and every
# skip is announced on stderr before any check runs.
#
# The token vocabulary below is GLOBAL — byte-identical in every canonical
# ResQ hook — so a value exported once for a shell session cannot mean
# different things in different hooks. A token owned by another hook is inert
# here rather than an error.
#
#   all | 1 | true | yes | on   disable this hook entirely (loud warning)
#   0 | false | no | off | none  explicit no-op: skip nothing (the old guard
#                                disabled the whole hook for these)
#   audit                       pre-commit   security audit (osv-scanner / audit-ci)
#   format                      pre-commit   code formatters
#   versioning                  pre-commit   changeset / version prompt
#   msg-format                  commit-msg   Conventional Commits subject check
#   wip-guard                   commit-msg   fixup!/squash!/WIP block on main
#   force-push                  pre-push     force-push guard on main/master
#   branch-name                 pre-push     branch naming convention
#   notify                      post-merge / post-checkout  lockfile drift notices
#   ticket                      prepare-commit-msg  branch ticket-ref prefix
#   local                       any hook     the repo-local local-<hook> override
#
# There is deliberately NO 'secrets' token. The secret scan is the compensating
# control for not licensing GitHub Secret Protection, so it is reachable only
# by the explicit all-off value (which says so, loudly) or by git's own
# per-invocation bypass flag.
#
# Separators: comma, colon or whitespace. Case-insensitive.

hskip_usage() {
    cat >&2 <<'HSKIP_USAGE'
   Valid GIT_HOOKS_SKIP tokens (comma / colon / space separated):
     all, 1, true, yes, on   disable the whole hook (prints a loud warning)
     0, false, no, off, none skip nothing (explicit no-op)
     audit                   pre-commit   security audit (osv-scanner / audit-ci)
     format                  pre-commit   code formatters
     versioning              pre-commit   changeset / version prompt
     msg-format              commit-msg   Conventional Commits subject check
     wip-guard               commit-msg   fixup!/squash!/WIP block on main
     force-push              pre-push     force-push guard on main/master
     branch-name             pre-push     branch naming convention
     notify                  post-merge / post-checkout  lockfile drift notices
     ticket                  prepare-commit-msg  branch ticket-ref prefix
     local                   any hook     repo-local local-<hook> override
   Examples:  GIT_HOOKS_SKIP=audit         GIT_HOOKS_SKIP=audit,format
   The secret scan has no token of its own. It is reachable only via
   GIT_HOOKS_SKIP=all or git's per-invocation bypass flag, and both are loud.
HSKIP_USAGE
}

HSKIP_ALL=0
HSKIP_SET=' '
HSKIP_BAD=''
HSKIP_BAD_SECRETS=0
if [ -n "${GIT_HOOKS_SKIP:-}" ]; then
    set -f  # tokens are parsed, never globbed
    for hskip_tok in $(printf '%s' "${GIT_HOOKS_SKIP:-}" | tr ',:' '  ' | tr '[:upper:]' '[:lower:]'); do
        case "$hskip_tok" in
            all|1|true|yes|on)
                HSKIP_ALL=1 ;;
            0|false|no|off|none)
                : ;;  # explicit "skip nothing"; the old guard disabled the
                      # whole hook for these, which nobody ever intended
            audit|format|versioning|msg-format|wip-guard|force-push|branch-name|notify|ticket|local)
                HSKIP_SET="${HSKIP_SET}${hskip_tok} " ;;
            secret|secrets|secret-scan|secrets-scan)
                HSKIP_BAD="${HSKIP_BAD}${hskip_tok} "
                HSKIP_BAD_SECRETS=1 ;;
            *)
                HSKIP_BAD="${HSKIP_BAD}${hskip_tok} " ;;
        esac
    done
    set +f
fi

if [ -n "$HSKIP_BAD" ]; then
    printf '\n❌ %s: GIT_HOOKS_SKIP=%s contains unrecognised token(s): %s\n' \
        "$HSKIP_HOOK" "${GIT_HOOKS_SKIP:-}" "${HSKIP_BAD% }" >&2
    if [ "$HSKIP_BAD_SECRETS" = 1 ]; then
        printf '   The secret scan is NOT individually skippable: it is the compensating\n' >&2
        printf '   control for unlicensed GitHub Secret Protection.\n' >&2
    fi
    if [ "$HSKIP_HARD_FAIL" = 1 ]; then
        printf '   Refusing to run. Failing closed on purpose: an unrecognised value used\n' >&2
        printf '   to mean "skip every check", which is the bug this parser replaces.\n' >&2
        hskip_usage
        exit 1
    fi
    printf '   Ignoring GIT_HOOKS_SKIP entirely; running every %s check.\n' "$HSKIP_HOOK" >&2
    hskip_usage
    HSKIP_ALL=0
    HSKIP_SET=' '
fi

# hskip <token> — true when this invocation must skip that check.
hskip() {
    if [ "$HSKIP_ALL" = 1 ]; then return 0; fi
    case "$HSKIP_SET" in *" $1 "*) return 0 ;; esac
    return 1
}

HSKIP_SKIPPED=''
HSKIP_RUNNING=''

# hskip_mark <token|''> <label> — record a check as skipped or running.
# An empty token means "only the all-off value can disable this check".
hskip_mark() {
    if { [ "$HSKIP_ALL" = 1 ]; } || { [ -n "$1" ] && hskip "$1"; }; then
        HSKIP_SKIPPED="${HSKIP_SKIPPED:+$HSKIP_SKIPPED, }$2"
    else
        HSKIP_RUNNING="${HSKIP_RUNNING:+$HSKIP_RUNNING, }$2"
    fi
    return 0
}

# hskip_report [emphasis-line] — name, on stderr, exactly what this invocation
# will and will not do. Silent when GIT_HOOKS_SKIP is unset: the "operator
# believes checks ran when they did not" hazard only exists when it is set.
# shellcheck disable=SC2120  # emphasis arg is optional; only pre-commit passes one
hskip_report() {
    if [ -z "${GIT_HOOKS_SKIP:-}" ]; then return 0; fi
    if [ "$HSKIP_ALL" != 1 ] && [ -z "$HSKIP_SKIPPED" ]; then
        printf '\nℹ️  GIT_HOOKS_SKIP=%s is set but disables nothing in %s — all checks ran.\n\n' \
            "${GIT_HOOKS_SKIP:-}" "$HSKIP_HOOK" >&2
        return 0
    fi
    if [ "$HSKIP_ALL" = 1 ]; then
        printf '\n🚨 GIT_HOOKS_SKIP=%s — EVERY %s CHECK IS DISABLED.\n' \
            "${GIT_HOOKS_SKIP:-}" "$HSKIP_HOOK" >&2
    else
        printf '\n⚠️  GIT_HOOKS_SKIP=%s is active for %s.\n' "${GIT_HOOKS_SKIP:-}" "$HSKIP_HOOK" >&2
    fi
    printf '   SKIPPED: %s\n' "${HSKIP_SKIPPED:-(nothing)}" >&2
    printf '   RUNNING: %s\n' "${HSKIP_RUNNING:-(nothing)}" >&2
    if [ -n "${1:-}" ]; then printf '   %s\n' "$1" >&2; fi
    printf '\n' >&2
}

hskip_mark 'wip-guard'  'fixup!/squash!/WIP guard on main'
hskip_mark 'msg-format' 'Conventional Commits subject format'
hskip_mark 'local'      'local-commit-msg'

if [ "$HSKIP_ALL" = 1 ]; then
    hskip_report ""
    exit 0
fi
hskip_report ""

INPUT_FILE="${1:-}"
# git always passes the message file, but the `${1:-}` default means a hook run
# by hand, or by a tool that forgets the argument, reaches `head -1 ""` instead —
# and `set -e` turns that into a bare tool error naming neither the hook nor the
# cause. Fail here, where the message can say what was expected.
if [ -z "$INPUT_FILE" ] || [ ! -f "$INPUT_FILE" ]; then
    echo "❌ commit-msg: expected a commit-message file as \$1, got '$INPUT_FILE'." >&2
    exit 1
fi

PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?(!)?: .+$"

FIRST_LINE=$(head -1 "$INPUT_FILE")
# Ticket-prefix regex matches what prepare-commit-msg prepends ({2,} chars).
SUBJECT=$(sed -E 's/^\[[A-Z]{2,}-[0-9]+\][[:space:]]*//' <<<"$FIRST_LINE")

# WIP / fixup! / squash! guard runs *before* the format check so users get
# a branch-specific error message on main/master instead of the generic
# "Invalid commit message format".
if ! hskip wip-guard; then
    BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
    case "$BRANCH" in
        main|master)
            if grep -qiE "^(\[[A-Z]{2,}-[0-9]+\] )?(fixup!|squash!|wip[: ])" <<<"$FIRST_LINE"; then
                echo "Error: fixup!/squash!/WIP commits are not allowed on $BRANCH."
                echo "Create a feature branch instead."
                exit 1
            fi
            ;;
    esac
fi

if ! hskip msg-format; then
    if ! grep -qE "$PATTERN" <<<"$SUBJECT"; then
        echo "Error: Invalid commit message format."
        echo "Expected: type(scope)(!): subject"
        echo "Examples:"
        echo "  feat(core): add new feature"
        echo "  feat!: remove deprecated API  (breaking change marker)"
        echo "  fix(ui): fix button color"
        exit 1
    fi
fi

LOCAL_HOOK="$(git rev-parse --show-toplevel)/.git-hooks/local-commit-msg"
if ! hskip local && [ -x "$LOCAL_HOOK" ]; then
    exec "$LOCAL_HOOK" "$@"
fi
