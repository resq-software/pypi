#
# Canonical ResQ pre-push shim — source: resq-software/dev.
# Force-push guard on main/master, branch naming convention, and an optional
# per-repo local-pre-push hook for language-specific checks
# (e.g. cargo check, ruff check, anchor build).

set -euo pipefail

HSKIP_HOOK='pre-push'
HSKIP_HARD_FAIL=1  # gating hook: refuse to run rather than guess at intent

# ── GIT_HOOKS_SKIP — granular, fail-closed skip control ─────────────────────
# Historically ANY non-empty value disabled the entire hook, so a plausible
# looking `GIT_HOOKS_SKIP=audit` silently turned off the secret scan as well.
# It no longer does: values are parsed, unknown values are refused, and every
# skip is announced on stderr before any check runs.
#
# The token vocabulary below is GLOBAL — byte-identical in every canonical
# ResQ hook — so a value exported once for a shell session cannot mean
# different things in different hooks. A token owned by another hook is inert
# here rather than an error.
#
#   all | 1 | true | yes | on   disable this hook entirely (loud warning)
#   0 | false | no | off | none  explicit no-op: skip nothing (the old guard
#                                disabled the whole hook for these)
#   audit                       pre-commit   security audit (osv-scanner / audit-ci)
#   format                      pre-commit   code formatters
#   versioning                  pre-commit   changeset / version prompt
#   msg-format                  commit-msg   Conventional Commits subject check
#   wip-guard                   commit-msg   fixup!/squash!/WIP block on main
#   force-push                  pre-push     force-push guard on main/master
#   branch-name                 pre-push     branch naming convention
#   notify                      post-merge / post-checkout  lockfile drift notices
#   ticket                      prepare-commit-msg  branch ticket-ref prefix
#   local                       any hook     the repo-local local-<hook> override
#
# There is deliberately NO 'secrets' token. The secret scan is the compensating
# control for not licensing GitHub Secret Protection, so it is reachable only
# by the explicit all-off value (which says so, loudly) or by git's own
# per-invocation bypass flag.
#
# Separators: comma, colon or whitespace. Case-insensitive.

hskip_usage() {
    cat >&2 <<'HSKIP_USAGE'
   Valid GIT_HOOKS_SKIP tokens (comma / colon / space separated):
     all, 1, true, yes, on   disable the whole hook (prints a loud warning)
     0, false, no, off, none skip nothing (explicit no-op)
     audit                   pre-commit   security audit (osv-scanner / audit-ci)
     format                  pre-commit   code formatters
     versioning              pre-commit   changeset / version prompt
     msg-format              commit-msg   Conventional Commits subject check
     wip-guard               commit-msg   fixup!/squash!/WIP block on main
     force-push              pre-push     force-push guard on main/master
     branch-name             pre-push     branch naming convention
     notify                  post-merge / post-checkout  lockfile drift notices
     ticket                  prepare-commit-msg  branch ticket-ref prefix
     local                   any hook     repo-local local-<hook> override
   Examples:  GIT_HOOKS_SKIP=audit         GIT_HOOKS_SKIP=audit,format
   The secret scan has no token of its own. It is reachable only via
   GIT_HOOKS_SKIP=all or git's per-invocation bypass flag, and both are loud.
HSKIP_USAGE
}

HSKIP_ALL=0
HSKIP_SET=' '
HSKIP_BAD=''
HSKIP_BAD_SECRETS=0
if [ -n "${GIT_HOOKS_SKIP:-}" ]; then
    set -f  # tokens are parsed, never globbed
    for hskip_tok in $(printf '%s' "${GIT_HOOKS_SKIP:-}" | tr ',:' '  ' | tr '[:upper:]' '[:lower:]'); do
        case "$hskip_tok" in
            all|1|true|yes|on)
                HSKIP_ALL=1 ;;
            0|false|no|off|none)
                : ;;  # explicit "skip nothing"; the old guard disabled the
                      # whole hook for these, which nobody ever intended
            audit|format|versioning|msg-format|wip-guard|force-push|branch-name|notify|ticket|local)
                HSKIP_SET="${HSKIP_SET}${hskip_tok} " ;;
            secret|secrets|secret-scan|secrets-scan)
                HSKIP_BAD="${HSKIP_BAD}${hskip_tok} "
                HSKIP_BAD_SECRETS=1 ;;
            *)
                HSKIP_BAD="${HSKIP_BAD}${hskip_tok} " ;;
        esac
    done
    set +f
fi

if [ -n "$HSKIP_BAD" ]; then
    printf '\n❌ %s: GIT_HOOKS_SKIP=%s contains unrecognised token(s): %s\n' \
        "$HSKIP_HOOK" "${GIT_HOOKS_SKIP:-}" "${HSKIP_BAD% }" >&2
    if [ "$HSKIP_BAD_SECRETS" = 1 ]; then
        printf '   The secret scan is NOT individually skippable: it is the compensating\n' >&2
        printf '   control for unlicensed GitHub Secret Protection.\n' >&2
    fi
    if [ "$HSKIP_HARD_FAIL" = 1 ]; then
        printf '   Refusing to run. Failing closed on purpose: an unrecognised value used\n' >&2
        printf '   to mean "skip every check", which is the bug this parser replaces.\n' >&2
        hskip_usage
        exit 1
    fi
    printf '   Ignoring GIT_HOOKS_SKIP entirely; running every %s check.\n' "$HSKIP_HOOK" >&2
    hskip_usage
    HSKIP_ALL=0
    HSKIP_SET=' '
fi

# hskip <token> — true when this invocation must skip that check.
hskip() {
    if [ "$HSKIP_ALL" = 1 ]; then return 0; fi
    case "$HSKIP_SET" in *" $1 "*) return 0 ;; esac
    return 1
}

HSKIP_SKIPPED=''
HSKIP_RUNNING=''

# hskip_mark <token|''> <label> — record a check as skipped or running.
# An empty token means "only the all-off value can disable this check".
hskip_mark() {
    if { [ "$HSKIP_ALL" = 1 ]; } || { [ -n "$1" ] && hskip "$1"; }; then
        HSKIP_SKIPPED="${HSKIP_SKIPPED:+$HSKIP_SKIPPED, }$2"
    else
        HSKIP_RUNNING="${HSKIP_RUNNING:+$HSKIP_RUNNING, }$2"
    fi
    return 0
}

# hskip_report [emphasis-line] — name, on stderr, exactly what this invocation
# will and will not do. Silent when GIT_HOOKS_SKIP is unset: the "operator
# believes checks ran when they did not" hazard only exists when it is set.
# shellcheck disable=SC2120  # emphasis arg is optional; only pre-commit passes one
hskip_report() {
    if [ -z "${GIT_HOOKS_SKIP:-}" ]; then return 0; fi
    if [ "$HSKIP_ALL" != 1 ] && [ -z "$HSKIP_SKIPPED" ]; then
        printf '\nℹ️  GIT_HOOKS_SKIP=%s is set but disables nothing in %s — all checks ran.\n\n' \
            "${GIT_HOOKS_SKIP:-}" "$HSKIP_HOOK" >&2
        return 0
    fi
    if [ "$HSKIP_ALL" = 1 ]; then
        printf '\n🚨 GIT_HOOKS_SKIP=%s — EVERY %s CHECK IS DISABLED.\n' \
            "${GIT_HOOKS_SKIP:-}" "$HSKIP_HOOK" >&2
    else
        printf '\n⚠️  GIT_HOOKS_SKIP=%s is active for %s.\n' "${GIT_HOOKS_SKIP:-}" "$HSKIP_HOOK" >&2
    fi
    printf '   SKIPPED: %s\n' "${HSKIP_SKIPPED:-(nothing)}" >&2
    printf '   RUNNING: %s\n' "${HSKIP_RUNNING:-(nothing)}" >&2
    if [ -n "${1:-}" ]; then printf '   %s\n' "$1" >&2; fi
    printf '\n' >&2
}

hskip_mark 'force-push'  'Force-push guard on main/master'
hskip_mark 'branch-name' 'Branch naming convention'
hskip_mark 'local'       'local-pre-push'

if [ "$HSKIP_ALL" = 1 ]; then
    hskip_report ""
    exit 0
fi
hskip_report ""

echo "🚀 Running pre-push checks..."

# Deliberately no `BRANCH=$(git symbolic-ref HEAD)` here. Every rule below reads
# the ref being pushed to, and a variable holding the checked-out branch is what
# both of them used to key on — which is how a force push to main from another
# branch got waved through. Keeping it around only invites that back.

# Capture stdin (the ref info git passes to pre-push) so both the force-push
# guard and any local-pre-push hook can read it.
PUSH_REFS=""
if [ ! -t 0 ]; then
    PUSH_REFS=$(cat)
fi

# ── Per-ref guards: force-push protection and branch naming ─────────────────
#
# Both rules read the ref being *written to*, never the checked-out branch.
# git names them separately for a reason: `git push origin +feature/x:main`
# rewrites main while HEAD is feature/x, so a guard keyed on HEAD waves through
# exactly the push it exists to stop. The same mistake inverts the naming rule,
# checking `main` (skipped) instead of the branch actually being created.
ZERO_SHA="0000000000000000000000000000000000000000"
ALLOWED_PATTERN="^(feat|fix|docs|chore|refactor|test|ci|perf|release)/.*$"
# Bot namespaces are exempt: nobody can rename a branch a bot creates, so
# enforcing the naming convention there only blocks legitimate pushes to those
# branches — a maintainer resolving a dependabot conflict, or a lockfile-sync
# workflow pushing from a reused checkout that still has core.hooksPath set.
# `changeset-release/` was already exempt for exactly this reason; dependabot
# and renovate were simply never added.
#
# Upstreamed from the monorepo, which patched its own copy after hitting this.
# Leaving it local guaranteed every repo would re-invent the same three words,
# so it belongs in the canonical template.
SKIP_BRANCHES="^(main|master|dev|develop|staging|production|changeset-release/.*|dependabot/.*|renovate/.*)$"

# Only iterate when git actually gave us refs — an empty $PUSH_REFS would
# otherwise feed one blank line through and be read as a record. Skipped
# wholesale only when BOTH per-ref rules are disabled.
if [ -n "$PUSH_REFS" ] && { ! hskip force-push || ! hskip branch-name; }; then
    while read -r _local_ref local_sha remote_ref remote_sha; do
        [ -z "$remote_ref" ] && continue

        # Tags and other refs fall outside both rules.
        case "$remote_ref" in
            refs/heads/*) target="${remote_ref#refs/heads/}" ;;
            *) continue ;;
        esac

        # Force-push guard. Skipped when either side is the all-zero SHA: that
        # is a branch being created or deleted, and there is no history to
        # overwrite.
        if ! hskip force-push; then
            case "$target" in
                main|master)
                    if [ "$remote_sha" != "$ZERO_SHA" ] && [ "$local_sha" != "$ZERO_SHA" ]; then
                        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
                            echo "❌ Force push to $target is not allowed."
                            echo "   Targeted override:  GIT_HOOKS_SKIP=force-push git push"
                            exit 1
                        fi
                    fi
                    ;;
            esac
        fi

        # Naming convention, on creates and updates only — deleting a
        # badly-named branch is how you get rid of it.
        if ! hskip branch-name && [ "$local_sha" != "$ZERO_SHA" ]; then
            if ! grep -qE "$SKIP_BRANCHES" <<<"$target"; then
                if ! grep -qE "$ALLOWED_PATTERN" <<<"$target"; then
                    echo "❌ Branch '$target' does not follow naming convention."
                    echo "   Expected: type/description  (e.g. feat/add-login)"
                    echo "   Allowed prefixes: feat, fix, docs, chore, refactor, test, ci, perf, release"
                    echo "   Targeted override:  GIT_HOOKS_SKIP=branch-name git push"
                    exit 1
                fi
            fi
        fi
    done <<EOF
$PUSH_REFS
EOF
fi

# ── Local override (language-specific checks) ───────────────────────────────
LOCAL_HOOK="$(git rev-parse --show-toplevel)/.git-hooks/local-pre-push"
if ! hskip local && [ -x "$LOCAL_HOOK" ]; then
    # Re-supply captured stdin so local hooks that inspect refs still work.
    # An empty $PUSH_REFS must stay empty: a heredoc would hand the local hook
    # one blank line, which a hook looping over refs reads as a record with
    # four empty fields. The guard above already avoids that for itself.
    # `pipefail` is set, so a failing local hook still fails the push.
    if [ -n "$PUSH_REFS" ]; then
        printf '%s\n' "$PUSH_REFS" | "$LOCAL_HOOK" "$@"
    else
        "$LOCAL_HOOK" "$@" </dev/null
    fi
fi

echo "✅ Pre-push checks passed"
