# Copyright (c) 2026 ResQ
#
# Example environment configuration for ResQ MCP Server
# Python service using pydantic-settings (RESQ_ prefix)
# Copy this file to .env and update with your actual values

# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────

# [optional] Display name for the MCP server
RESQ_PROJECT_NAME=resQ MCP Server

# [optional] Server version string
RESQ_VERSION=0.1.0

# [optional] Enable debug logging
RESQ_DEBUG=false

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────

# [required for network transports] Active bearer token.
# Network transports (http/sse/streamable-http) REFUSE to start with this default
# value — generate a real one: python -c "import secrets; print(secrets.token_urlsafe(32))"
RESQ_API_KEY=resq-dev-token

# [optional] Previous token, accepted during a rotation grace window so in-flight
# clients can migrate without a hard cutover. Leave empty to disable.
RESQ_API_KEY_PREVIOUS=

# [optional] Seconds a rotated-out (previous) token remains valid.
RESQ_API_KEY_GRACE_SECONDS=3600

# ─────────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────────

# [optional] Transport: stdio (default, client-spawned) | http | sse | streamable-http
RESQ_TRANSPORT=stdio

# [optional] Port for network transport (http/sse/streamable-http)
RESQ_PORT=8000

# [optional] Host to bind to
RESQ_HOST=0.0.0.0

# ─────────────────────────────────────────────
# Fleet backend
# ─────────────────────────────────────────────

# [optional] Base URL of fleet-api (no trailing slash). Empty = in-memory mock.
# Point this at a running fleet-api to replace the drone roster / swarm /
# dispatch mocks with live HTTP calls.
# RESQ_FLEET_API_URL=http://127.0.0.1:8000

# ─────────────────────────────────────────────
# Safety & Features
# ─────────────────────────────────────────────

# [optional] If true, side-effecting tools (run_simulation, update_mission_params)
# raise a FastMCPError. Set to false in production with proper auth controls.
RESQ_SAFE_MODE=true

# ─────────────────────────────────────────────
# Audit & Detection (NSA PP-26-1834)
# ─────────────────────────────────────────────

# [optional] Emit structured, hash-anchored audit records on the resq-mcp.audit logger.
RESQ_AUDIT_ENABLED=true

# ─────────────────────────────────────────────
# Rate Limiting (NSA PP-26-1834: DoS / fatigue mitigation)
# ─────────────────────────────────────────────

# [optional] Enforce per-tool call-rate limits.
RESQ_RATE_LIMIT_ENABLED=true

# [optional] Maximum calls per tool within the window.
RESQ_RATE_LIMIT_MAX_CALLS=60

# [optional] Sliding-window width, in seconds.
RESQ_RATE_LIMIT_WINDOW_SECONDS=60
